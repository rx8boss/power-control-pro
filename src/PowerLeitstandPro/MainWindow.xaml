          <TextBlock x:Name="MottoText" Text="Windows steuern · Aktionen planen · System reparieren" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource HeaderSubtleBrush}" Margin="0,2,0,0"/>
