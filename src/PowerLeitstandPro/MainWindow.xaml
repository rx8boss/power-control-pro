          <Button x:Name="AdminRightsBadge" Click="OpenAdminStatus" Style="{StaticResource SmallButton}" Width="132" Height="32" Margin="7,0,0,0" Padding="5,2" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource WarningBrush}" ToolTip="Die App wurde nicht als Administrator gestartet"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path x:Name="AdminRightsIcon" Data="M 12,1 L 21,5 L 20,13 C 19,18 15,21 12,23 C 9,21 5,18 4,13 L 3,5 Z" Stroke="{DynamicResource WarningBrush}" StrokeThickness="2" Width="16" Height="17" Stretch="Uniform" Margin="0,0,5,0"/><TextBlock x:Name="AdminRightsStatus" Text="Ohne Adminrechte" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
