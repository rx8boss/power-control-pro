          <TextBlock x:Name="WarningVolumeTitle" Grid.Row="5" Text="Timer-Lautstärke" FontWeight="Bold" VerticalAlignment="Center" Margin="0"/><StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Slider x:Name="WarningVolume" Minimum="0" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" Width="136" VerticalAlignment="Center" ValueChanged="WarningVolumeChanged"/><TextBlock x:Name="WarningVolumeValue" Text="80%" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel>
          <TextBlock x:Name="AutoStartTitle" Grid.Row="6" Text="Mit Windows starten" FontWeight="Bold" VerticalAlignment="Center" Margin="0"/><CheckBox x:Name="AutoStart" Grid.Row="6" Grid.Column="1" Content="Autostart aktiv" Foreground="{DynamicResource TextBrush}" Margin="0" VerticalAlignment="Center" Click="ToggleAutoStart"/>
        </Grid><Button x:Name="DoneButton" Content="Fertig" Click="ToggleSettings" Margin="0,12,0,0" HorizontalAlignment="Center" Width="150"/>
      </StackPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource FooterBrush}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="POWER CONTROL PRO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FooterTextBrush}"/><Image Source="Assets/icons/neon/bolt.png" Width="15" Height="15" Margin="9,0,9,0"/><TextBlock Text="v1.0.2 · WPF" FontSize="11" Foreground="{DynamicResource FooterTextBrush}"/></StackPanel></Border>
  </Grid>
</Window>
