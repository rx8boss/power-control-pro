<Window x:Class="PowerControlProWpf.RepairResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Control PRO" Icon="Assets/app-icon.ico"
        Width="560" Height="330" MinWidth="560" MinHeight="330"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBrush" Color="#152535"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1B3145"/>
    <SolidColorBrush x:Key="InputBrush" Color="#13283A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F9FC"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#C4D8E8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#72BFFA"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#416E8F"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#24445D"/>
    <SolidColorBrush x:Key="ReadyBrush" Color="#4ABF91"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#B75E76"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#254A63"/>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DialogCloseButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#E92749"/><Setter Property="BorderBrush" Value="#FFC0CC"/>
      </Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" Padding="18" Background="{DynamicResource AppBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="49"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="DragDialog">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="DialogIcon" Source="Assets/icons/neon/status.png" Width="32" Height="32" Margin="0,0,10,0"/>
          <TextBlock x:Name="DialogHeader" Text="Windows-Reparatur" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Width="32" Height="30" Click="CloseDialog" Style="{StaticResource DialogCloseButton}"
                Background="#A51D36" BorderBrush="#FF6388" Foreground="White" Content="×" FontSize="20" Padding="0"/>
      </Grid>
      <Border x:Name="ResultCard" Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,10,0,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border x:Name="ResultBadge" Width="50" Height="50" CornerRadius="25" BorderThickness="3"
                    BorderBrush="{DynamicResource ReadyBrush}" Margin="0,0,14,0">
              <TextBlock x:Name="ResultSymbol" Text="✓" FontSize="31" FontWeight="Bold"
                         Foreground="{DynamicResource ReadyBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ResultTitle" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{DynamicResource ReadyBrush}" VerticalAlignment="Center" Width="415"/>
          </StackPanel>
          <TextBlock x:Name="ResultMessage" FontSize="14" Foreground="{DynamicResource TextBrush}"
                     TextWrapping="Wrap" MaxHeight="78"/>
          <TextBlock x:Name="ResultDetail" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"
                     Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="LaterButton" Width="126" Height="36" Margin="0,0,8,0" Click="CloseDialog"
                Style="{StaticResource DialogButton}" Content="Später"/>
        <Button x:Name="RestartButton" Width="178" Height="36" Click="RestartDialog"
                Style="{StaticResource DialogButton}" Background="{DynamicResource SuccessBrush}"
                BorderBrush="{DynamicResource ReadyBrush}" Foreground="White" Content="Jetzt neu starten"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
