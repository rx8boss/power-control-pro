{
  "name": "power-control",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": { "start": "electron .", "build": "electron-builder" },
  "devDependencies": { "electron": "^30.0.0", "electron-builder": "^24.13.3" },
  "dependencies": { "auto-launch": "^5.0.6" },
  "build": {
    "appId": "com.powercontrol.pro",
    "productName": "Power Control PRO",
    "asar": true,
    "files": ["**/*"],
    "win": { "target": "portable", "icon": "assets/icon.png", "artifactName": "power-control-${version}.exe" }
  }
}
