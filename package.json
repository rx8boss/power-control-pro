{
  "name": "power-control-pro",
  "version": "1.0.1",
  "description": "Windows power controls with timer, log and autostart.",
  "productName": "Power Control PRO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:single-exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-single-exe.ps1"
  },
  "dependencies": {
    "auto-launch": "^5.0.6"
  },
  "devDependencies": {
    "electron": "^37.2.6"
  },
  "allowScripts": {
    "electron": true
  }
}
