<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../PowerControlProWpf.csproj" />
    <Resource Include="../../Assets/app-icon.ico" Link="Assets/app-icon.ico" />
    <Resource Include="../../Assets/logo.png" Link="Assets/logo.png" />
    <Resource Include="../../Assets/icons/**/*.png" Link="Assets/icons/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
